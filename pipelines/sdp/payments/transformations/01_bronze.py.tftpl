"""SDP bronze view: preserve the Firehose JSON landing without coercion."""

import json

import boto3
from pyspark import pipelines as dp
from pyspark.sql import DataFrame, SparkSession
from pyspark.sql.functions import input_file_name
from pyspark.sql.types import (
    BooleanType,
    DoubleType,
    LongType,
    StringType,
    StructField,
    StructType,
)

spark = SparkSession.active()
BRONZE_PATH = "${bronze_path}"
REGISTRY_NAME = "${registry_name}"
SCHEMA_NAME = "${schema_name}"
AWS_REGION = "${aws_region}"

dp.create_streaming_table(
    "bronze_payments",
    comment="Raw payment events as landed by Firehose",
    table_properties={"write.spark.accept-any-schema": "true"},
)


@dp.append_flow(target="bronze_payments")
def ingest_bronze() -> DataFrame:
    definition = json.loads(
        boto3.client("glue", region_name=AWS_REGION).get_schema_version(
            SchemaId={"RegistryName": REGISTRY_NAME, "SchemaName": SCHEMA_NAME},
            SchemaVersionNumber={"LatestVersion": True},
        )["SchemaDefinition"]
    )
    spark_types = {
        "string": StringType(),
        "number": DoubleType(),
        "double": DoubleType(),
        "integer": LongType(),
        "long": LongType(),
        "boolean": BooleanType(),
    }
    schema = StructType(
        [
            StructField(
                name,
                spark_types.get(
                    spec.get("type") if isinstance(spec, dict) else spec,
                    StringType(),
                ),
                True,
            )
            for name, spec in definition["properties"].items()
        ]
    )
    return (
        spark.readStream.format("json")
        .schema(schema)
        .option("recursiveFileLookup", "true")
        .option("mergeSchema", "true")
        .load(BRONZE_PATH)
        .withColumn("source_file", input_file_name().cast("string"))
        # Match the evolved Iceberg table: amount was appended after country.
        .select(
            "event_id",
            "merchant_id",
            "user_id",
            "amount_usd",
            "currency",
            "status",
            "event_timestamp",
            "source_file",
            "country",
            "amount",
        )
    )
